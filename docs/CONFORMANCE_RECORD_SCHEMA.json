{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/megaalive/semasm/blob/main/docs/CONFORMANCE_RECORD_SCHEMA.json",
  "title": "SemASM CI conformance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "commit",
    "target",
    "runner",
    "outcome",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "tool_version": { "type": "string", "pattern": "^0\\.[0-9]+\\.[0-9]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target": { "type": "string", "minLength": 1 },
    "runner": { "type": "string", "minLength": 1 },
    "outcome": {
      "enum": ["passed", "failed", "skipped", "unavailable", "not_applicable"]
    },
    "reason": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
